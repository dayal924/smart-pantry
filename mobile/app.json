{
  "expo": {
    "name": "Smart Pantry",
    "slug": "smart-pantry",
    "version": "1.0.0",
    "scheme": "smartpantry",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.smartpantry.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan your groceries to add them to your pantry.",
        "NSPhotoLibraryUsageDescription": "Pick a photo of your groceries to scan."
      }
    },
    "android": {
      "package": "com.smartpantry.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B130E"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan your groceries to add them to your pantry."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a photo of your groceries to scan."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2E7D32"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"],
            "packagingOptions": {
              "pickFirst": [
                "**/libreactnative.so",
                "**/libc++_shared.so"
              ]
            },
            "extraGradleProperties": {
              "android.packagingOptions.pickFirsts": "**/libreactnative.so,**/libc++_shared.so"
            }
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1654ffde-9735-418c-8787-282e28fbe10a"
      }
    },
    "owner": "dayal_008"
  }
}
