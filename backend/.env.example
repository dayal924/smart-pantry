MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=smart_pantry
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=you@example.com

# Copilot: groq | gemini | openrouter | none (rule-based fallback is always available)
LLM_PROVIDER=groq

# 1. Groq (Primary Free AI)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini (Automatic Fallback #1)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 3. OpenRouter (Automatic Fallback #2 - Free Tier Models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
